# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL Database (Optional for remote Supabase instance, persistent local SQLite/JSON storage active by default)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Finik Payment Gateway (OPTIONAL - Currently DISABLED by default)
# Primary payment method: MBank QR (ОсОО «Билет Центр»)
# Set FINIK_ENABLED=true only when direct Finik acquiring agreement is finalized.
FINIK_ENABLED=false
# Environment: 'beta' for sandbox testing or 'production' for live payments
FINIK_ENVIRONMENT=beta
FINIK_ACCOUNT_ID=
FINIK_API_KEY=
FINIK_SECRET_KEY=

# Telegram Admin Notifications (Active notification channel)
# TELEGRAM_ENABLED=true to activate Telegram bot notifications
# Bot token and chat ID are used strictly server-side
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Notifications (OPTIONAL - Currently unused/inactive)
# Kept for backward-compatibility only
ADMIN_WHATSAPP_PHONE=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

